# Copiá este archivo como ".env" y completá los datos.

# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_TOKEN=

# Números de usuario de Telegram que pueden usar el bot, separados por coma.
# Para saber tu número, escribile /miid al bot.
TELEGRAM_USUARIOS_PERMITIDOS=

# Clave de Anthropic para que Claude lea las fotos de las facturas
ANTHROPIC_API_KEY=
# Modelo de Claude que lee las facturas
CLAUDE_MODEL=claude-opus-5-5

# Clave para entrar a la página web (si queda vacía, no pide clave)
CLAVE_ACCESO=

# Dirección de la página, para que el bot mande el link (opcional)
URL_PUBLICA=http://localhost:8000

# Ganancia que se sugiere al crear productos (en %)
MARGEN_POR_DEFECTO=40
# A partir de qué cantidad se avisa "queda poco stock"
STOCK_BAJO=2

# Impresora térmica de etiquetas (Xprinter, TSC o similar), conectada por USB.
# Poné el nombre tal como aparece en "Impresoras" de Windows (por ejemplo: Xprinter XP-365B).
IMPRESORA_NOMBRE=
# Solo si la impresora está en la red (WiFi o cable): su dirección IP. Si no, dejalo vacío.
IMPRESORA_IP=
# Tamaño de etiqueta por defecto: 55x28, 50x30, 60x40, 40x40 o 55x45 (se puede cambiar en la página)
ETIQUETA_TAMANO=55x28
# Espacio entre etiquetas del rollo, en mm
ETIQUETA_SEPARACION_MM=2
